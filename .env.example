# Gere uma senha forte para acesso ao estúdio.
ADMIN_PASSWORD=
# 32+ caracteres aleatórios; usado para assinar sessões.
SESSION_SECRET=
# Modo sem custos: mock. Produção: higgsfield.
GENERATION_PROVIDER=mock
# Apenas servidor/worker. Formato KEY_ID:KEY_SECRET.
HF_CREDENTIALS=
# SQLite persistente. Para produção multi-instância, adapte o provider Prisma para PostgreSQL.
DATABASE_URL=file:./dev.db
# Armazenamento local no modo mock; em produção use s3 com bucket privado.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dev: localhost:3000. Produção: origem HTTPS pública.
APP_ORIGIN=http://localhost:3000
